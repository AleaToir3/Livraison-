# --- Mode ---------------------------------------------------------------------------------------
# En production: APP_ENV=production désactive le géocodage synthétique de repli et la doc OpenAPI.
APP_ENV=development
API_KEY=

# --- Géocodage UK (au moins un fournisseur réel en production) ------------------------------------
IDEAL_POSTCODES_API_KEY=
OS_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Vide = déduit de APP_ENV. Mettre "false" pour refuser tout point synthétique.
ALLOW_SYNTHETIC_GEOCODING=

# --- Vision fallback --------------------------------------------------------------------------------
GEMINI_API_KEY=

# --- Dimensionnement ----------------------------------------------------------------------------------
SOLVER_WORKERS=2
UVICORN_WORKERS=1
REDIS_MAXMEMORY=512mb
OSRM_THREADS=4
OSRM_SHM_SIZE=10gb
# Les deux plafonds doivent rester cohérents : le backend (BACKEND_MAX_TABLE_SIZE) <= le serveur (OSRM_MAX_TABLE_SIZE).
OSRM_MAX_TABLE_SIZE=500
BACKEND_MAX_TABLE_SIZE=250
